@model IEnumerable<TourismWebSite.Models.Tours>
@{
    ViewBag.Title = "Tour Packages";

    var totalPackages = Model.Count();
    var activePackages = Model.Count(t => t.EndDate >= DateTime.Today);

 
    int totalBookings = ViewBag.TotalBookings as int? ?? 0;
    decimal totalRevenue = ViewBag.TotalRevenue as decimal? ?? 0m;

    var bookingCounts = ViewBag.BookingCounts as IDictionary<int, int>
                        ?? new Dictionary<int, int>();
}

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />

<div class="d-flex flex-column flex-md-row align-items-md-center justify-content-md-between mb-4">
    <div>
        <h1 class="h3 mb-1">Tour Packages</h1>
        <div class="text-muted">Manage all tours and create new experiences</div>
    </div>
    <div class="mt-3 mt-md-0">
        <a class="btn btn-primary btn-lg" href="@Url.Action("Create","Packages")">
            <i class="bi bi-plus-lg me-2"></i>Create Package
        </a>
    </div>
</div>

<!-- Stats -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card h-100">
            <div class="card-body">
                <div class="small text-muted">Total Packages</div>
                <div class="fs-4 fw-bold">@totalPackages</div>
                <div class="small text-muted">All time</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card h-100">
            <div class="card-body">
                <div class="small text-muted">Active Packages</div>
                <div class="fs-4 fw-bold">@activePackages</div>
                <div class="small text-muted">End date in future</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card h-100">
            <div class="card-body">
                <div class="small text-muted">Total Bookings</div>
                <div class="fs-4 fw-bold">@totalBookings</div>
                <div class="small text-muted">All tours</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card h-100">
            <div class="card-body">
                <div class="small text-muted">Revenue</div>
                <div class="fs-4 fw-bold">@totalRevenue.ToString("C")</div>
                <div class="small text-muted">Completed only</div>
            </div>
        </div>
    </div>
</div>

<!-- Table -->
<div class="card">
    <div class="card-header">
        <strong>All Packages</strong>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Package Name</th>
                        <th>Destination</th>
                        <th>Duration</th>
                        <th>Dates</th>
                        <th class="text-end">Price</th>
                        <th class="text-center">Bookings</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@item.Name</td>
                            <td>@item.Destination</td>
                            <td>@item.DurationDays day(s)</td>
                            <td>
                                @item.StartDate.ToShortDateString() – @item.EndDate.ToShortDateString()
                            </td>
                            <td class="text-end">@item.Price.ToString("C")</td>
                            <td class="text-center">
                                @(bookingCounts.ContainsKey(item.Id) ? bookingCounts[item.Id].ToString() : "—")
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-1">
                                    <a class="btn btn-sm btn-outline-secondary"
                                       title="Edit"
                                       href="@Url.Action("Edit", "Packages", new { id = item.Id })">
                                        <i class="bi bi-pencil"></i><span class="visually-hidden"> Edit</span>
                                    </a>

                                    <a class="btn btn-sm btn-outline-secondary"
                                       title="Details"
                                       href="@Url.Action("Details", "Packages", new { id = item.Id })">
                                        <i class="bi bi-eye"></i><span class="visually-hidden"> Details</span>
                                    </a>

                                    <a class="btn btn-sm btn-outline-danger"
                                       title="Delete"
                                       href="@Url.Action("Delete", "Packages", new { id = item.Id })">
                                        <i class="bi bi-trash"></i><span class="visually-hidden"> Delete</span>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
