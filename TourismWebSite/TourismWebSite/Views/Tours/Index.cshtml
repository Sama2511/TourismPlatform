@model IEnumerable<TourismWebSite.Models.Tours>
@{
    ViewBag.Title = "Tours";
    Func<string, string> ImgOrPlaceholder = (path) =>
        Url.Content(string.IsNullOrWhiteSpace(path) ? "~/Content/placeholder-tour.png" : path);
}

<div class="py-3">
    <h1 class="h3 mb-1">All Tours</h1>
    <p class="text-muted mb-4">Discover amazing destinations and book your perfect getaway</p>

    <form class="row gy-2 gx-2 align-items-center mb-3" method="get" action="@Url.Action("Index")">
        <div class="col-12 col-md">
            <div class="input-group">
                <span class="input-group-text">🔎</span>
                <input name="q"
                       value="@Request["q"]"
                       class="form-control"
                       placeholder="Search by name or destination…" />
            </div>
        </div>
        <div class="col-auto">
            <a class="btn btn-outline-secondary" href="@Url.Action("Index","Tours")">Clear</a>
        </div>
    </form>

</div>

<div class="row g-4">
    @foreach (var t in Model)
    {
        <div class="col-12 col-sm-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                <img class="card-img-top" src="@ImgOrPlaceholder(t.ImageUrl)" alt="@t.Name" style="height:200px; object-fit:cover;">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title mb-1">@t.Name</h5>

                    <div class="text-muted small mb-2">
                        @t.Destination • @t.DurationDays day(s)
                    </div>

                    <p class="mb-2 flex-grow-0">
                        @((t.Description ?? "").Length > 120 ? (t.Description.Substring(0, 120) + "…") : t.Description)
                    </p>

                    <div class="small text-muted mb-2">
                        @t.StartDate.ToShortDateString() – @t.EndDate.ToShortDateString()
                    </div>

                    <div class="fw-semibold mb-3">@t.Price.ToString("C")</div>

                    <div class="mt-auto d-flex gap-2">
                        @if (Request.IsAuthenticated)
                        {
                            <!-- Go to payment for this tour -->
                            <a class="btn btn-primary"
                               href="@Url.Action("Payment", "Tours", new { id = t.Id })">
                                Book
                            </a>
                        }
                        else
                        {
                            <!-- After login, come back to payment for THIS tour -->
                            <a class="btn btn-primary"
                               href="@Url.Action("Login", "Account", new { ReturnUrl = Url.Action("Payment","Tours", new { id = t.Id }) })">
                                Log in to book
                            </a>
                        }

                        <a class="btn btn-outline-primary" href="@Url.Action("Details","Tours", new { id = t.Id })">
                            Details
                        </a>
                    </div>

                </div>
            </div>
        </div>
    }
</div>
